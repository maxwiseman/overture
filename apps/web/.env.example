DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/overture
# Hosted PostgreSQL URLs should use sslmode=verify-full.
PAYLOAD_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
# ARTICLE_GENERATION_MODEL=openai/gpt-5.4-mini

# Sign in with Apple web Service ID and native App ID.
APPLE_CLIENT_ID=com.example.overture.web
APPLE_APP_BUNDLE_IDENTIFIER=com.overture.news.swiftui

# Preferred: generate Apple's client-secret JWT at server startup.
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_SIGN_IN_WITH_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Alternative: provide a pre-generated JWT and rotate it before it expires.
# APPLE_CLIENT_SECRET=generated-apple-client-secret
